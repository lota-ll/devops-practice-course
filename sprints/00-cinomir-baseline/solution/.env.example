# Скопіюйте у .env (make env) і заповніть. .env у git НЕ комітимо.

# --- Telegram (потрібно лише для `make up-bot`) ---
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram id через кому. Не знаєте? Залиште порожнім, напишіть боту — він відповість вашим id.
ALLOWED_USER_IDS=

# --- База і кеш (значення за замовчуванням підходять для docker compose) ---
POSTGRES_PASSWORD=cinomir
LOG_LEVEL=INFO

# --- Мережі ---
ENABLED_CHAINS=silpo,fora,novus
CHAIN_TIMEOUT_SECONDS=8
# Чесний User-Agent: хто ми і що робимо
# CHAIN_USER_AGENT=cinomir/0.1 (personal price comparison, low rate; contact: you@example.com)

# Ідентифікатори магазинів (Київ, гостьовий режим без адреси)
# SILPO_BRANCH=00000000-0000-0000-0000-000000000000
# FORA_FILIAL=3805
# NOVUS_STORE=48201031
